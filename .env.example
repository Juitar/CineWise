SPRING_PROFILES_ACTIVE=demo
TZ=Asia/Shanghai
BACKEND_PORT=8080
FRONTEND_PORT=8000

MYSQL_DATABASE=cinewise
MYSQL_USER=cinewise_app
MYSQL_PASSWORD=replace-with-cloud-shared-database-password
MYSQL_HOST=replace-with-cloud-mysql-host
MYSQL_PORT=3306

REDIS_HOST=replace-with-cloud-shared-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-cloud-shared-redis-password

# 由各模块负责人启用相应能力时填写，严禁提交真实值。
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_AUDIT_HASH_SECRET=replace-with-another-at-least-32-byte-secret
AUTH_VERIFICATION_HASH_SECRET=replace-with-a-third-at-least-32-byte-secret
AUTH_INVITE_HASH_SECRET=replace-with-a-fourth-at-least-32-byte-secret
AUTH_CURRENT_PRIVACY_POLICY_VERSION=2026-08-03
AUTH_INITIAL_INVITE_ENABLED=false
TRAINING_INVITE_CODE=
AUTH_INITIAL_INVITE_MAX_USES=100
AUTH_INITIAL_INVITE_VALID_FROM=2026-08-05T00:00:00
AUTH_INITIAL_INVITE_EXPIRE_TIME=2026-12-31T23:59:59.999
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_RENEWAL_THRESHOLD=10m
AUTH_ABSOLUTE_SESSION_TTL=8h
AUTH_COOKIE_SECURE=false
AUTH_VERIFICATION_SMTP_ENABLED=false
AUTH_VERIFICATION_MAIL_FROM=
AUTH_MAIL_DELIVERY_ENABLED=false
AUTH_MAIL_DELIVERY_PROVIDER=smtp
AUTH_MAIL_DELIVERY_FROM=
AUTH_VIEWING_REMINDER_MAIL_SUBJECT=
AUTH_VIEWING_REMINDER_MAIL_BODY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_SSL_ENABLED=false
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=false
SMTP_TEST_CONNECTION=false
AUTH_DEMO_SEED_ENABLED=false
AUTH_DEMO_USER_EMAIL=user@cinewise.test
AUTH_DEMO_USER_PASSWORD=replace-with-local-user-password
AUTH_DEMO_USER_NICKNAME=演示用户
AUTH_DEMO_ADMIN_EMAIL=admin@cinewise.test
AUTH_DEMO_ADMIN_PASSWORD=replace-with-local-admin-password
AUTH_DEMO_ADMIN_NICKNAME=演示管理员
AUTH_DEMO_PRIVACY_POLICY_VERSION=2026-08-03
MODEL_API_KEY=
CONTENT_PROVIDER_KEY=
WEATHER_API_KEY=

TICKET_LOCK_MINUTES=15
ORDER_PAYMENT_MINUTES=15
FLYWAY_ENABLED=false
SEED_ENABLED=false
SEED_FIXED_VALUE=20260802

# 云端 MinIO 可选；使用 API 端点，不得填写 Console 地址或 root 管理员凭据。
MINIO_ENDPOINT=http://replace-with-cloud-minio-host:9000
MINIO_ACCESS_KEY=replace-with-minio-application-access-key
MINIO_SECRET_KEY=replace-with-minio-application-secret-key
MINIO_BUCKET=cinewise
# DeepSeek 只在显式开启时读取；真实密钥仅放本地 .env 或 GitHub Actions Secret。
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
