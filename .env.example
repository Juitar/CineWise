SPRING_PROFILES_ACTIVE=demo
TZ=Asia/Shanghai
BACKEND_PORT=8080
FRONTEND_PORT=8000

MYSQL_DATABASE=cinewise
MYSQL_USER=cinewise_app
MYSQL_PASSWORD=replace-with-cloud-shared-database-password
MYSQL_HOST=replace-with-cloud-mysql-host
MYSQL_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password

# 由各模块负责人启用相应能力时填写，严禁提交真实值。
JWT_SECRET=replace-with-at-least-32-random-bytes
MODEL_API_KEY=
CONTENT_PROVIDER_KEY=
WEATHER_API_KEY=

TICKET_LOCK_MINUTES=15
ORDER_PAYMENT_MINUTES=15
FLYWAY_ENABLED=false
SEED_ENABLED=false
SEED_FIXED_VALUE=20260802

# 云端 MinIO 可选；不得使用或提交 MinIO root 管理员凭据。
MINIO_ENDPOINT=https://replace-with-cloud-minio-endpoint
MINIO_ACCESS_KEY=replace-with-minio-application-access-key
MINIO_SECRET_KEY=replace-with-minio-application-secret-key
MINIO_BUCKET=cinewise
