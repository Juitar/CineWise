SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Shanghai

MYSQL_DATABASE=cinewise
MYSQL_USER=cinewise
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-password

# 由各模块负责人启用相应能力时填写，严禁提交真实值。
JWT_SECRET=replace-with-at-least-32-random-bytes
MODEL_API_KEY=
CONTENT_PROVIDER_KEY=
WEATHER_API_KEY=

TICKET_LOCK_MINUTES=15
ORDER_PAYMENT_MINUTES=15
SEED_ENABLED=true
SEED_FIXED_VALUE=20260731

# storage profile 可选；MVP 默认不启动 MinIO。
MINIO_ROOT_USER=cinewise-minio
MINIO_ROOT_PASSWORD=replace-with-local-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=cinewise-assets
