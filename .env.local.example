# 本机 Docker Desktop 联调模板：复制为仓库根目录 .env，真实值不得提交。
# 先启动 SSH 隧道，再让 Docker 经 host.docker.internal 访问隧道。
SPRING_PROFILES_ACTIVE=demo
TZ=Asia/Shanghai
BACKEND_PORT=8080
FRONTEND_PORT=8000

MYSQL_HOST=host.docker.internal
MYSQL_PORT=13306
MYSQL_DATABASE=cinewise
MYSQL_USER=cinewise_app
MYSQL_PASSWORD=CHANGE_ME_SHARED_MYSQL_APP_PASSWORD

REDIS_HOST=host.docker.internal
REDIS_PORT=16379
REDIS_PASSWORD=CHANGE_ME_SHARED_REDIS_PASSWORD

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
AUTH_AUDIT_HASH_SECRET=CHANGE_ME_ANOTHER_32_RANDOM_BYTES
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_COOKIE_SECURE=false
# 仅在 C 已确认允许向共享库补齐缺失演示账号时改为 true。
AUTH_DEMO_SEED_ENABLED=false
AUTH_DEMO_USER_EMAIL=user@cinewise.test
AUTH_DEMO_USER_PASSWORD=CHANGE_ME_LOCAL_DEMO_USER_PASSWORD
AUTH_DEMO_USER_NICKNAME=演示用户
AUTH_DEMO_ADMIN_EMAIL=admin@cinewise.test
AUTH_DEMO_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEMO_ADMIN_PASSWORD
AUTH_DEMO_ADMIN_NICKNAME=演示管理员
AUTH_DEMO_PRIVACY_POLICY_VERSION=2026-08-03

TICKET_LOCK_MINUTES=15
ORDER_PAYMENT_MINUTES=15
FLYWAY_ENABLED=false
SEED_ENABLED=false
SEED_FIXED_VALUE=20260802

# 本机默认不自动同步真实内容或执行定时任务，避免对共享服务产生意外写入。
CINEWISE_CONTENT_NETSTART_ENABLED=false
CINEWISE_CONTENT_NETSTART_SYNC_ON_STARTUP=false
CINEWISE_CONTENT_NETSTART_BASE_URL=https://apis.netstart.cn/maoyan
CINEWISE_SCHEDULING_ENABLED=false

# 未启用对象存储时保持空；启用后仅使用 A 提供的最小权限应用账号。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=cinewise
